<Window x:Class="Biblioteca.WPF.Views.DevolucionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar devolución" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TitleText}" Text="Devolución"/>
            <TextBlock x:Name="txtReglas" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Pendientes -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SOCIO" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSocio" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                                  SelectionChanged="CmbSocio_SelectionChanged"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgPendientes" SelectionChanged="DgPendientes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRÉSTAMO" Binding="{Binding PrestamoId}" Width="100"/>
                            <DataGridTextColumn Header="LIBRO" Binding="{Binding Libro}" Width="2*"/>
                            <DataGridTextColumn Header="F. PRÉSTAMO" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="F. LÍMITE" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Multa -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Cálculo de multa" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="FECHA DE DEVOLUCIÓN"/>
                    <TextBlock x:Name="txtFecha" FontSize="15" Foreground="{StaticResource TextMainBrush}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="DÍAS DE RETRASO"/>
                    <TextBlock x:Name="txtDias" FontSize="15" Foreground="{StaticResource TextMainBrush}" Text="-"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="MULTA"/>
                    <TextBlock x:Name="txtMulta" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="S/ 0.00"/>

                    <Button Content="Registrar devolución" Style="{StaticResource PrimaryButton}" Margin="0,26,0,0" Click="BtnDevolver_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>