<Window x:Class="Biblioteca.WPF.Views.SociosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de socios" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TitleText}" Text="Socios"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Registre, edite y dé de baja a los socios de la biblioteca."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Listado -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscar" KeyDown="TxtBuscar_KeyDown" ToolTip="Buscar por nombre o DNI"/>
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="BtnBuscar_Click"/>
                        <Button Grid.Column="2" Content="Limpiar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnLimpiarBusqueda_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgSocios" SelectionChanged="DgSocios_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="110"/>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="2*"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="txtModo" Text="Nuevo socio" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="DNI"/>
                    <TextBox x:Name="txtDni" MaxLength="8"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE COMPLETO"/>
                    <TextBox x:Name="txtNombre" MaxLength="100"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="CORREO ELECTRÓNICO"/>
                    <TextBox x:Name="txtEmail" MaxLength="100"/>

                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="BtnGuardar_Click"/>
                    <Button Content="Nuevo" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="BtnNuevo_Click"/>
                    <Button Content="Dar de baja" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="BtnEliminar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>