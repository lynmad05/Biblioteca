<Window x:Class="Biblioteca.WPF.Views.LibrosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de libros" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TitleText}" Text="Libros"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Registre, edite y dé de baja libros del catálogo."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Listado -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscar" KeyDown="TxtBuscar_KeyDown" ToolTip="Buscar por título o autor"/>
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="BtnBuscar_Click"/>
                        <Button Grid.Column="2" Content="Limpiar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnLimpiarBusqueda_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgLibros" SelectionChanged="DgLibros_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="2*"/>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
                            <DataGridTextColumn Header="AUTOR" Binding="{Binding AutorNombre}" Width="*"/>
                            <DataGridTextColumn Header="EJEMPLARES" Binding="{Binding Ejemplares}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="txtModo" Text="Nuevo libro" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="TÍTULO"/>
                    <TextBox x:Name="txtTitulo" MaxLength="200"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="ISBN"/>
                    <TextBox x:Name="txtIsbn" MaxLength="20"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="AUTOR"/>
                    <ComboBox x:Name="cmbAutor" DisplayMemberPath="Nombre" SelectedValuePath="AutorId"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="EJEMPLARES"/>
                    <TextBox x:Name="txtEjemplares" MaxLength="4"/>

                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="BtnGuardar_Click"/>
                    <Button Content="Nuevo" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="BtnNuevo_Click"/>
                    <Button Content="Dar de baja" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="BtnEliminar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>