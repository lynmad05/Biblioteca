<Window x:Class="Biblioteca.WPF.Views.PrestamoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar préstamo" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TitleText}" Text="Nuevo préstamo"/>
            <TextBlock x:Name="txtReglas" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Selección -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SOCIO" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSocio" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                                  SelectionChanged="CmbSocio_SelectionChanged"/>
                        <TextBlock x:Name="txtPendientes" Style="{StaticResource MutedText}" Margin="2,6,0,0"
                                   Text="Seleccione un socio para ver sus libros pendientes."/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LIBRO"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbLibro">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Titulo, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding AutorNombre, Mode=OneWay, StringFormat=' · {0}'}" Foreground="#6B7280"/>
                                            <Run Text="{Binding Ejemplares, Mode=OneWay, StringFormat=' · {0} ejemplar(es)'}" Foreground="#6B7280"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Agregar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="BtnAgregar_Click"/>
                        </Grid>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="dgSeleccion">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LIBROS A PRESTAR" Binding="{Binding Titulo}" Width="2*"/>
                            <DataGridTextColumn Header="AUTOR" Binding="{Binding AutorNombre}" Width="*"/>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Resumen -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Resumen" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock x:Name="txtCantidad" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                    <TextBlock x:Name="txtLimite" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

                    <Button Content="Registrar préstamo" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="BtnRegistrar_Click"/>
                    <Button Content="Quitar libro seleccionado" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="BtnQuitar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>