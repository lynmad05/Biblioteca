<Window x:Class="Biblioteca.WPF.Views.ReporteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de préstamos" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TitleText}" Text="Reporte de préstamos"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Consulte los préstamos realizados dentro de un intervalo de fechas."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="DESDE" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpDesde" Width="170"/>
                    </StackPanel>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="HASTA" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpHasta" Width="170"/>
                    </StackPanel>
                    <Button Content="Generar reporte" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="38" Margin="14,0,0,0" Click="BtnGenerar_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgReporte">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding PrestamoId}" Width="60"/>
                        <DataGridTextColumn Header="SOCIO" Binding="{Binding Socio}" Width="*"/>
                        <DataGridTextColumn Header="LIBRO" Binding="{Binding Libro}" Width="1.5*"/>
                        <DataGridTextColumn Header="F. PRÉSTAMO" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="115"/>
                        <DataGridTextColumn Header="FECHA LÍMITE" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="115"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="Foreground" Value="#B45309"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Devuelto">
                                            <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" x:Name="txtTotal" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>