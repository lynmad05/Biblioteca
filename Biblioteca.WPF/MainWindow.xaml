<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Biblioteca" Width="1180" Height="740" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,28">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="&#x201C;" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,-6,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Foreground="White" Text="Un libro es un sueño que sostienes en tus manos."/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="14,11" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" Foreground="White" FontSize="14" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource NavButton}" Click="BtnLibros_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Libros" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="BtnSocios_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Socios" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="BtnPrestamo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Nuevo préstamo" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="BtnDevolucion_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Devolución" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="BtnReporte_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <TextBlock Text="Reportes" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENIDO ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28">

                <StackPanel Margin="8,0,0,18">
                    <TextBlock Style="{StaticResource TitleText}" Text="Bienvenido de nuevo 👋" FontSize="24"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Gestión de libros, socios, préstamos y devoluciones" Margin="0,4,0,0"/>
                </StackPanel>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Libros" Foreground="White" FontSize="14" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtTotalLibros" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Registrados"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#1E2E55" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Socios" Foreground="White" FontSize="14" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtTotalSocios" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Activos"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#14392E" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Préstamos" Foreground="White" FontSize="14" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtPrestamosActivos" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Pendientes"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#44281A" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource OrangeBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Devoluciones" Foreground="White" FontSize="14" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtDevolucionesHoy" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Hoy"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Accesos rápidos" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="8,22,0,6"/>

                <UniformGrid Columns="3">
                    <Button Style="{StaticResource MenuCard}" Height="150" Click="BtnLibros_Click">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Libros" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,2"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Mantenimiento y búsqueda por título o autor"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuCard}" Height="150" Click="BtnSocios_Click">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="#1E2E55" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Socios" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,2"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Mantenimiento y búsqueda por nombre o DNI"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuCard}" Height="150" Click="BtnPrestamo_Click">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="#14392E" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nuevo préstamo" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,2"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Registrar el préstamo de uno o varios libros"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuCard}" Height="150" Click="BtnDevolucion_Click">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="#44281A" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Devolución" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,2"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Registrar devoluciones y calcular la multa"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuCard}" Height="150" Click="BtnReporte_Click">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Reporte de préstamos" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,2"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Consulta por intervalo de fechas"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>